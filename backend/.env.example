# Copy this file to backend/.env and fill in real values for anything
# beyond local development. None of these are required to just run the app
# locally — see README.md.

# JWT/session signing keys. If unset, app.py generates one and persists it to
# backend/instance/secret.key / jwt_secret.key on first run (gitignored) so
# local dev stays stable across restarts. Set these explicitly for any real
# deployment — generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
JWT_SECRET=

# Defaults to a local SQLite file. Point this at Postgres/MySQL for anything
# beyond single-process local development, e.g.:
# DATABASE_URL=postgresql://user:password@localhost:5432/faultsense
DATABASE_URL=sqlite:///fault_detection.db

# Comma-separated list of allowed origins, or * for any (fine for local dev,
# tighten this for a real deployment).
CORS_ORIGINS=*

# Port the Flask/Socket.IO server listens on.
PORT=5000

# true/false — defaults to false (see app.py). Only set true for local
# development: it enables Werkzeug's interactive debugger, which lets anyone
# who triggers an unhandled exception run arbitrary code in the browser.
FLASK_DEBUG=false

# Outbound email for password-reset and email-verification links. If
# SMTP_HOST is left unset, those emails are logged to the server console
# instead of sent — fine for local/team-internal use where whoever runs the
# server can relay the link, not fine if strangers are expected to self-serve.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Rate-limit storage. Defaults to in-memory, which only works correctly for
# a single process — under gunicorn with >1 worker each worker would track
# limits independently, so a client could get roughly (limit × workers)
# requests through instead of the configured limit. Point this at Redis for
# any multi-worker deployment (pip install redis first):
# RATELIMIT_STORAGE_URI=redis://localhost:6379
RATELIMIT_STORAGE_URI=memory://
